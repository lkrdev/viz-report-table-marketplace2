    "node": ">=24.21.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.26.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "babel-loader": "^9.2.1",
    "css-loader": "^6.8.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "style-loader": "^1.2.1",
    "typescript": "^5.7.3",
    "url-loader": "^4.1.0",
    "webpack": "^5.67.0",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "^5.2.4"
  },
  "dependencies": {
    "d3": "^5.16.0",
    "d3-drag": "^1.2.5",
    "d3-selection": "^1.4.2",
