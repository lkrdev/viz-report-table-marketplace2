    "build": "webpack",
    "watch": "webpack --watch --progress",
    "dev": "webpack serve --server-type https --hot --mode development"
  },
  "jest": {
    "modulePathIgnorePatterns": [
      "<rootDir>/tmp"
    ],
    "transformIgnorePatterns": [
